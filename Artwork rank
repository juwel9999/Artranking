<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Art Ranking</title>

<style>

/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f4f4f4;
    color: #111;
    overflow-x: hidden;
}


/* =========================
   ANIMATED BACKGROUND
========================= */

body::before,
body::after {
    content: "";
    position: fixed;
    z-index: -5;
    pointer-events: none;
}

body::before {
    width: 500px;
    height: 500px;

    background:
        repeating-linear-gradient(
            45deg,
            transparent 0px,
            transparent 30px,
            rgba(220, 40, 50, 0.07) 31px,
            rgba(220, 40, 50, 0.07) 33px
        );

    transform: rotate(-15deg);
    animation: backgroundMove 15s linear infinite;
}

body::after {
    width: 350px;
    height: 350px;

    right: -100px;
    bottom: 0;

    border: 2px solid rgba(220, 40, 50, 0.12);

    transform: rotate(45deg);
    animation: floatingShape 8s ease-in-out infinite alternate;
}

@keyframes backgroundMove {
    from {
        transform: translate(-150px, -100px) rotate(-15deg);
    }

    to {
        transform: translate(200px, 300px) rotate(-15deg);
    }
}

@keyframes floatingShape {
    from {
        transform: translateY(0) rotate(45deg);
    }

    to {
        transform: translateY(-100px) rotate(65deg);
    }
}


/* =========================
   HEADER
========================= */

header {
    min-height: 430px;
    position: relative;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    overflow: hidden;
}

.logo {
    font-size: 50px;
    font-weight: 1000;
    font-style: italic;
    letter-spacing: -6px;
    transform: skew(-10deg);

    margin-bottom: 40px;
}

.menu {
    position: absolute;
    top: 0;
    right: 0;

    width: 90px;
    height: 100px;

    background: #050505;
    color: white;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 12px;
    letter-spacing: 2px;
}

.menu::before {
    content: "☰";
    font-size: 28px;

    position: absolute;
    top: 15px;
}

.menu span {
    margin-top: 50px;
}

.title {
    width: 100%;
    text-align: center;

    font-size: clamp(65px, 12vw, 150px);
    font-weight: 900;
    letter-spacing: -5px;

    color: #f23843;

    animation: titleMove 4s ease-in-out infinite alternate;
}

@keyframes titleMove {
    from {
        transform: translateX(-10px);
    }

    to {
        transform: translateX(10px);
    }
}


/* =========================
   CHARACTER CONTAINER
========================= */

.characters {
    width: min(1100px, 94%);
    margin: auto;

    padding-bottom: 100px;
}


/* =========================
   CHARACTER CARD
========================= */

.character-card {
    height: 405px;

    position: relative;

    margin: 15px 0;

    cursor: pointer;

    overflow: hidden;

    background: #111;

    clip-path: polygon(
        0 0,
        43% 0,
        50% 16%,
        73% 0,
        100% 0,
        100% 100%,
        30% 100%,
        23% 83%,
        0 100%
    );

    transition:
        transform 0.35s ease,
        filter 0.35s ease;
}

.character-card:hover {
    transform: scale(1.015);
    filter: brightness(1.08);
}


/* Image */

.character-image {
    position: absolute;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.6s ease;
}

.character-card:hover .character-image {
    transform: scale(1.06);
}


/* Dark overlay */

.character-card::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            110deg,
            rgba(0,0,0,0.35),
            transparent 45%,
            rgba(0,0,0,0.15)
        );

    pointer-events: none;
}


/* =========================
   BLACK GEOMETRIC SHAPES
========================= */

.shape-left {
    position: absolute;

    width: 260px;
    height: 100%;

    left: -40px;

    background: #000;

    clip-path: polygon(
        0 0,
        100% 0,
        65% 50%,
        100% 100%,
        0 100%
    );

    z-index: 2;
}

.shape-right {
    position: absolute;

    width: 240px;
    height: 100%;

    right: -20px;

    background: #000;

    clip-path: polygon(
        30% 0,
        100% 0,
        100% 100%,
        0 100%,
        50% 50%
    );

    z-index: 2;
}


/* =========================
   TEXT
========================= */

.hero-name {
    position: absolute;

    right: 20%;
    top: 35px;

    z-index: 5;

    color: white;

    text-align: center;
}

.hero-name small {
    display: block;

    font-size: 11px;
    letter-spacing: 2px;

    background: #050505;

    padding: 6px 10px;
}

.hero-name strong {
    display: block;

    font-size: clamp(18px, 3vw, 30px);

    margin-top: 8px;

    letter-spacing: 1px;
}


.ranking {
    position: absolute;

    left: 25px;
    bottom: 20px;

    z-index: 6;

    color: white;
}

.ranking small {
    display: inline-block;

    background: #050505;

    padding: 6px 8px;

    font-size: 10px;
    letter-spacing: 2px;
}

.number {
    display: block;

    font-size: clamp(65px, 10vw, 110px);

    font-weight: 900;

    line-height: 0.9;

    color: #f23843;

    text-shadow: 2px 2px 0 #111;
}


/* =========================
   MODAL
========================= */

.modal {
    position: fixed;

    inset: 0;

    background: rgba(0,0,0,0.85);

    display: none;

    align-items: center;
    justify-content: center;

    z-index: 100;

    padding: 20px;

    backdrop-filter: blur(8px);
}

.modal.active {
    display: flex;
}

.modal-box {
    width: min(900px, 95vw);
    max-height: 90vh;

    overflow-y: auto;

    background: #f4f4f4;

    position: relative;

    animation: modalIn 0.35s ease;
}

@keyframes modalIn {
    from {
        opacity: 0;
        transform: translateY(40px) scale(0.95);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.modal-image {
    width: 100%;
    height: 400px;

    object-fit: cover;

    display: block;
}

.modal-content {
    padding: 30px;
}

.modal-ranking {
    color: #f23843;

    font-size: 14px;
    letter-spacing: 3px;

    font-weight: bold;
}

.modal-title {
    font-size: clamp(35px, 7vw, 70px);

    font-weight: 900;

    margin: 5px 0 15px;
}

.modal-description {
    font-size: 16px;

    line-height: 1.7;

    color: #444;

    max-width: 700px;
}

.stats {
    display: flex;
    flex-wrap: wrap;

    gap: 10px;

    margin-top: 25px;
}

.stat {
    background: #111;

    color: white;

    padding: 10px 15px;

    font-size: 12px;

    letter-spacing: 1px;
}

.close {
    position: absolute;

    right: 15px;
    top: 15px;

    width: 45px;
    height: 45px;

    border: none;

    background: #f23843;

    color: white;

    font-size: 25px;

    cursor: pointer;

    z-index: 10;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    header {
        min-height: 320px;
    }

    .logo {
        font-size: 38px;
    }

    .character-card {
        height: 300px;
    }

    .shape-left {
        width: 130px;
    }

    .shape-right {
        width: 130px;
    }

    .hero-name {
        right: 8%;
        top: 25px;
    }

    .hero-name strong {
        font-size: 15px;
    }

    .ranking {
        left: 15px;
        bottom: 15px;
    }

    .number {
        font-size: 65px;
    }

    .modal-image {
        height: 280px;
    }

    .modal-content {
        padding: 20px;
    }
}

</style>
</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header>

    <div class="menu">
        <span>MENU</span>
    </div>

    <div class="logo">
        TOP HERO X
    </div>

    <h1 class="title">
        CHARACTER
    </h1>

</header>



<!-- =========================
     CHARACTERS
========================= -->

<main class="characters">


    <!-- CHARACTER 01 -->

    <article
        class="character-card"
        onclick="openCharacter(0)"
    >

        <img
            class="character-image"
            src="images/hero-x.jpg"
            alt="Hero X"
        >

        <div class="shape-left"></div>

        <div class="shape-right"></div>

        <div class="hero-name">

            <small>HERO NAME</small>

            <strong>HERO X</strong>

        </div>

        <div class="ranking">

            <small>RANKING NO.</small>

            <span class="number">01</span>

        </div>

    </article>



    <!-- CHARACTER 02 -->

    <article
        class="character-card"
        onclick="openCharacter(1)"
    >

        <img
            class="character-image"
            src="images/queen.jpg"
            alt="Queen"
        >

        <div class="shape-left"></div>

        <div class="shape-right"></div>

        <div class="hero-name">

            <small>HERO NAME</small>

            <strong>QUEEN</strong>

        </div>

        <div class="ranking">

            <small>RANKING NO.</small>

            <span class="number">02</span>

        </div>

    </article>



    <!-- CHARACTER 03 -->

    <article
        class="character-card"
        onclick="openCharacter(2)"
    >

        <img
            class="character-image"
            src="images/dragon-boy.jpg"
            alt="Dragon Boy"
        >

        <div class="shape-left"></div>

        <div class="shape-right"></div>

        <div class="hero-name">

            <small>HERO NAME</small>

            <strong>DRAGON BOY</strong>

        </div>

        <div class="ranking">

            <small>RANKING NO.</small>

            <span class="number">03</span>

        </div>

    </article>



    <!-- CHARACTER 04 -->

    <article
        class="character-card"
        onclick="openCharacter(3)"
    >

        <img
            class="character-image"
            src="images/ghostblade.jpg"
            alt="Ghostblade"
        >

        <div class="shape-left"></div>

        <div class="shape-right"></div>

        <div class="hero-name">

            <small>HERO NAME</small>

            <strong>GHOSTBLADE</strong>

        </div>

        <div class="ranking">

            <small>RANKING NO.</small>

            <span class="number">04</span>

        </div>

    </article>



    <!-- CHARACTER 05 -->

    <article
        class="character-card"
        onclick="openCharacter(4)"
    >

        <img
            class="character-image"
            src="images/johnnies.jpg"
            alt="The Johnnies"
        >

        <div class="shape-left"></div>

        <div class="shape-right"></div>

        <div class="hero-name">

            <small>HERO NAME</small>

            <strong>THE JOHNNIES</strong>

        </div>

        <div class="ranking">

            <small>RANKING NO.</small>

            <span class="number">05</span>

        </div>

    </article>



    <!-- CHARACTER 06 -->

    <article
        class="character-card"
        onclick="openCharacter(5)"
    >

        <img
            class="character-image"
            src="images/loli.jpg"
            alt="Loli"
        >

        <div class="shape-left"></div>

        <div class="shape-right"></div>

        <div class="hero-name">

            <small>HERO NAME</small>

            <strong>LOLI</strong>

        </div>

        <div class="ranking">

            <small>RANKING NO.</small>

            <span class="number">06</span>

        </div>

    </article>


</main>



<!-- =========================
     CHARACTER MODAL
========================= -->

<div
    class="modal"
    id="characterModal"
    onclick="closeOutside(event)"
>

    <div class="modal-box">

        <button
            class="close"
            onclick="closeCharacter()"
        >
            ×
        </button>

        <img
            id="modalImage"
            class="modal-image"
            src=""
            alt=""
        >

        <div class="modal-content">

            <div
                id="modalRanking"
                class="modal-ranking"
            ></div>

            <h2
                id="modalTitle"
                class="modal-title"
            ></h2>

            <p
                id="modalDescription"
                class="modal-description"
            ></p>

            <div
                id="modalStats"
                class="stats"
            ></div>

        </div>

    </div>

</div>



<script>

/* =========================
   CHARACTER DATA
========================= */

const characters = [

    {
        name: "HERO X",

        ranking: "RANKING NO. 01",

        image: "images/hero-x.jpg",

        description:
            "A mysterious and powerful hero whose abilities and origins remain unknown. His calm personality hides an incredible amount of strength.",

        stats: [
            "POWER: 98",
            "SPEED: 91",
            "SKILL: 95",
            "RANK: S+"
        ]
    },


    {
        name: "QUEEN",

        ranking: "RANKING NO. 02",

        image: "images/queen.jpg",

        description:
            "A legendary warrior known for her overwhelming presence and extraordinary combat abilities.",

        stats: [
            "POWER: 96",
            "SPEED: 89",
            "SKILL: 99",
            "RANK: S+"
        ]
    },


    {
        name: "DRAGON BOY",

        ranking: "RANKING NO. 03",

        image: "images/dragon-boy.jpg",

        description:
            "A wild fighter with mysterious dragon-related abilities. His fighting style is unpredictable and extremely aggressive.",

        stats: [
            "POWER: 94",
            "SPEED: 97",
            "SKILL: 90",
            "RANK: S"
        ]
    },


    {
        name: "GHOSTBLADE",

        ranking: "RANKING NO. 04",

        image: "images/ghostblade.jpg",

        description:
            "A silent warrior who specializes in speed, precision and devastating blade attacks.",

        stats: [
            "POWER: 91",
            "SPEED: 99",
            "SKILL: 98",
            "RANK: S"
        ]
    },


    {
        name: "THE JOHNNIES",

        ranking: "RANKING NO. 05",

        image: "images/johnnies.jpg",

        description:
            "A strange group of fighters whose unpredictable abilities make them difficult to defeat.",

        stats: [
            "POWER: 87",
            "SPEED: 85",
            "SKILL: 92",
            "RANK: A+"
        ]
    },


    {
        name: "LOLI",

        ranking: "RANKING NO. 06",

        image: "images/loli.jpg",

        description:
            "A mysterious character who appears harmless but possesses abilities that should never be underestimated.",

        stats: [
            "POWER: 88",
            "SPEED: 93",
            "SKILL: 89",
            "RANK: A+"
        ]
    }

];


/* =========================
   OPEN CHARACTER
========================= */

function openCharacter(index) {

    const character = characters[index];

    document.getElementById("modalImage").src =
        character.image;

    document.getElementById("modalImage").alt =
        character.name;

    document.getElementById("modalRanking").textContent =
        character.ranking;

    document.getElementById("modalTitle").textContent =
        character.name;

    document.getElementById("modalDescription").textContent =
        character.description;


    const stats =
        document.getElementById("modalStats");

    stats.innerHTML = "";

    character.stats.forEach(stat => {

        const element =
            document.createElement("div");

        element.className = "stat";

        element.textContent = stat;

        stats.appendChild(element);

    });


    document
        .getElementById("characterModal")
        .classList.add("active");


    document.body.style.overflow = "hidden";
}


/* =========================
   CLOSE CHARACTER
========================= */

function closeCharacter() {

    document
        .getElementById("characterModal")
        .classList.remove("active");

    document.body.style.overflow = "";
}


/* =========================
   CLOSE WHEN CLICKING OUTSIDE
========================= */

function closeOutside(event) {

    if (
        event.target.id ===
        "characterModal"
    ) {
        closeCharacter();
    }

}


/* =========================
   ESC KEY
========================= */

document.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Escape") {

            closeCharacter();

        }

    }
);

</script>

</body>
</html>
